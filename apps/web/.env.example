# =============================================================================
# ADSSPOT — PRODUCTION AWS & CLOUD CONFIGURATION
# =============================================================================

# 1. AWS Aurora Serverless v2 PostgreSQL (with PostGIS extension)
DATABASE_URL=postgresql://adsspot_admin:your_secure_password@aurora-cluster.ap-south-1.rds.amazonaws.com:5432/adsspot

# 2. AWS ElastiCache for Redis (Feed & Story Sub-Millisecond Caching)
REDIS_URL=redis://adsspot-feed-cache.ap-south-1.cache.amazonaws.com:6379

# 3. Amazon S3 & CloudFront CDN (Merchant Media & Stamped Banners)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET=adsspot-media-prod
AWS_CLOUDFRONT_DOMAIN=https://cdn.adsspot.in

# 4. Optional Supabase / Firebase / SMS Gateways
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy_anon_key
